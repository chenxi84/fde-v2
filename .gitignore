# 数据库文件（启动时自动创建）
*.db
*.db-shm
*.db-wal

# 应用运行时上传/产出文件（resource/import-file、resource/export-file）
resource/

# 本地配置文件
config/.env
config/mock.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# 虚拟环境
venv/
.venv/

# 密钥
config/llm_master.key
config/.secret_key

# 平台运行时锁文件
fde_platform/.dbguard.lock

# 运行日志
config/logs/

# PostgreSQL 数据目录
pgdata/

# TLS 证书（本地生成，不提交）
certs/

# 测试临时文件
config/.testexec/

# 实验产出
spike_out/

# AgentScope agent_service 运行时工作区
config/agent_workspaces/

# 宣传材料（含个人联系方式、未公开草稿、发布策略等）
宣传/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
app/crm/
view/crm/

# 知识图谱（LightRAG）：索引数据 / pyvis 副产物 / 可视化输出（均可重新生成）
config/kg_storage/
/lib/
知识图谱.html

# 制度库：README 说明入库，制度文件本身私有不提交
config/rules/*
!config/rules/README.md
