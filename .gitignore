# 数据库文件（启动时自动创建）
*.db
*.db-shm
*.db-wal

# 应用运行时上传/产出文件（resource/import-file、resource/export-file）
resource/

# 本地配置文件
config/.env
config/mock.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# 虚拟环境
venv/
.venv/

# 密钥
config/llm_master.key
config/.secret_key

# 平台运行时锁文件
fde_platform/.dbguard.lock

# 运行日志
config/logs/
# nginx 访问日志（docker-compose 把 ./logs 挂到容器的 /var/log/fde）
/logs/

# PostgreSQL 数据目录
pgdata/

# TLS 证书（本地生成，不提交）
certs/

# 测试临时文件
config/.testexec/

# 实验产出
spike_out/

# AgentScope agent_service 运行时工作区
config/agent_workspaces/

# 宣传材料（含个人联系方式、未公开草稿、发布策略等）
宣传/

# Claude Code 本地会话目录
.claude/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
app/crm/
view/crm/

# 知识图谱（LightRAG）：索引数据 / pyvis 副产物 / 可视化输出（均可重新生成）
config/kg_storage/
/lib/
知识图谱.html

# 原始书籍（app/<组>/book/）：**默认不提交** —— 二进制、体积大、常为版权书。
# 转换后的分章 md 落在 app/<组>/brd/，那份要提交（是 design-plus 第①步的输入）。
app/*/book/
# ⚠ 例外（2026-09-25 用户指定）：nasa_pms 的原始书**入库** ——
# NASA SP-2016-6105 Rev2 是美国政府作品（公有领域，无版权与分发限制），3.6 MB，
# 且它是本组 `brd/` 全部分章 md 的**唯一真相源**：留在仓里，clone 下来即可复核
# 「材料 → BRD」这段转换是否忠实（书不在，那些 md 就成了无法对质的孤本）。
# 将来若往 book/ 放**受版权保护**的书，别照这个例外走 —— 那类继续靠 .gitignore 挡在仓外。
!app/nasa_pms/book/

# 制度库：README 说明入库，制度文件本身私有不提交
config/rules/*
!config/rules/README.md

# 流程编排（Flow）：**运行时经前端页面创建/编辑的那些仍属用户数据、不入库**；
# 但**参考实现组**（nasa_pms / psc）的流程是随仓交付的样板 —— 文档、片子、门禁都指着它们，
# 新克隆的仓库得能复现「让 AI 管家跑一条链」。故：整体忽略 + 两个组例外（同 book/ 的写法）。
# ⚠ 以后**新加的组**若也要随仓交付流程，**在这里加一行例外**，别把整条忽略去掉。
_flow_*.yaml
!app/nasa_pms/_flow_*.yaml
!app/psc/_flow_*.yaml

# 本地起 agent_service 时的控制台日志（每台机器一份，不入库）
/_agent_service.log
