# FDE v2 平台配置模板 —— 复制为 config/.env 后按需填写。

# 平台浏览器端端口
PLATFORM_PORT=4000

# 监听地址（默认 127.0.0.1；Docker 部署时改为 0.0.0.0）
PLATFORM_HOST=127.0.0.1

# LLM（Agent 用；兼容 OpenAI 接口的国产模型，如 DeepSeek / 通义千问 / 智谱）
# 留空则 Agent 走"未配置"降级，不影响应用清单/手工调用/MCP。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat

# 数据库连接（留空 = SQLite 本地文件；Docker 部署时设为 PostgreSQL 连接串）
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 会话签名密钥（鉴权用；留空则自动生成随机密钥并持久化到 config/.secret_key）
# SECRET_KEY=
